":"u158cde06"}],"why":"机器+飞 →「会飞的机器」＝飞机。เครื่อง+动词＝「…的机器」。"},"แผนที่":{"parts":[{"th":"แผน","roman":"phɛ̌ɛn","zh":"计划；图样","id":"prt-udb2e6a4b"},{"th":"ที่","roman":"thîi","zh":"地方","id":"w014"}],"why":"图样/计划+地方 →「地方的图样」＝地图。"},"โรงแรม":{"parts":[{"th":"โรง","roman":"roong","zh":"场所；厂","id":"prt-udc4445cf"},{"th":"แรม","roman":"rɛɛm","zh":"住宿；过夜","id":"prt-u5b74c814"}],"why":"场所+住宿 →「住宿的场所」＝酒店。"},"ถ่ายรูป":{"parts":[{"th":"ถ่าย","roman":"thàai","zh":"拍；复制","id":"prt-ucadb3723"},{"th":"รูป","roman":"rûup","zh":"图像；形象","id":"u2b69b79e"}],"why":"拍/复制+图像 ＝拍照。"},"ภูเขา":{"parts":[{"th":"ภู","roman":"phuu","zh":"山","id":"prt-u80137b32"},{"th":"เขา","roman":"khǎo","zh":"山（同义叠加，这里不是「他」）","id":"u2109a5cf"}],"why":"ภู 和 เขา 都是「山」，两个同义词叠在一起（泰语常这样），不是「他」。"},"ผลไม้":{"parts":[{"th":"ผล","roman":"phǒn","zh":"果实","id":"prt-u13ca3b1a"},{"th":"ไม้","roman":"máai","zh":"树木；木头","id":"u8484676d"}],"why":"果实+树木 →「树上的果实」＝水果。"},"น้ำตาล":{"parts":[{"th":"น้ำ","roman":"náam","zh":"水","id":"w023"},{"th":"ตาล","roman":"taan","zh":"糖棕（棕榈）","id":"prt-u26ef4ff9"}],"why":"水+糖棕 →「糖棕树的汁」→ 糖（早期糖来自棕榈汁）。"},"รองเท้า":{"parts":[{"th":"รอง","roman":"rɔɔng","zh":"垫；承托","id":"prt-u279b4e1e"},{"th":"เท้า","roman":"tháao","zh":"脚","id":"u01b9a263"}],"why":"垫/承托+脚 →「垫在脚下的」＝鞋。"},"ส่วนลด":{"parts":[{"th":"ส่วน","roman":"sùan","zh":"部分","id":"prt-u4614e413"},{"th":"ลด","roman":"lót","zh":"减少；降","id":"w050"}],"why":"部分+减少 →「减掉的那部分」＝折扣。"},"ครอบครัว":{"parts":[{"th":"ครอบ","roman":"khrɔ̂ɔp","zh":"覆盖；罩住","id":"prt-u58ab7b67"},{"th":"ครัว","roman":"khrua","zh":"厨房；家（古义）","id":"prt-ufb8b8c7c"}],"why":"覆盖/罩住+家（古义：厨房）→「罩在一个屋檐下」＝家庭。"},"ผู้ชาย":{"parts":[{"th":"ผู้","roman":"phûu","zh":"…的人","id":"prt-u62000f5d"},{"th":"ชาย","roman":"chaai","zh":"男","id":"prt-u282a92cd"}],"why":"ผู้=…的人，ชาย=男 →「男的人」。ผู้+X＝「做 X 的人」。"},"ผู้หญิง":{"parts":[{"th":"ผู้","roman":"phûu","zh":"…的人","id":"prt-u62000f5d"},{"th":"หญิง","roman":"yǐng","zh":"女","id":"prt-u1176c64c"}],"why":"…的人+女 ＝女人。"},"นักเรียน":{"parts":[{"th":"นัก","roman":"nák","zh":"…者；…家","id":"prt-u8c65d0da"},{"th":"เรียน","roman":"rian","zh":"学习","id":"u5f6892ce"}],"why":"นัก=…者/…家，เรียน=学习 →「学习的人」。นัก+动词＝「专业做这事的人」：นักร้อง 歌手。"},"โรงเรียน":{"parts":[{"th":"โรง","roman":"roong","zh":"场所；厂","id":"prt-udc4445cf"},{"th":"เรียน","roman":"rian","zh":"学习","id":"u5f6892ce"}],"why":"场所+学习 →「学习的场所」＝学校。"},"หนังสือ":{"parts":[{"th":"หนัง","roman":"nǎng","zh":"皮；影","id":"prt-ue92044bd"},{"th":"สือ","roman":"sɯ̌ɯ","zh":"传达；文字","id":"prt-ufeaccd69"}],"why":"หนัง=皮，สือ=传达 →「写在皮上、传达信息的东西」＝书（词源解释，帮助记忆）。"},"ได้ยิน":{"parts":[{"th":"ได้","roman":"dâi","zh":"得到","id":"w009"},{"th":"ยิน","roman":"yin","zh":"听到（古）","id":"prt-ud010a1ae"}],"why":"得到+听到 →「听到了」＝听见。"},"ว่ายน้ำ":{"parts":[{"th":"ว่าย","roman":"wâai","zh":"游","id":"prt-ua60a4d3e"},{"th":"น้ำ","roman":"náam","zh":"水","id":"w023"}],"why":"游+水 ＝游泳。"},"ต้นไม้":{"parts":[{"th":"ต้น","roman":"tôn","zh":"树干；棵","id":"prt-udad2c606"},{"th":"ไม้","roman":"máai","zh":"树木；木头","id":"u8484676d"}],"why":"ต้น=树干/棵，ไม้=木 →「木的主干」＝树。"},"ดอกไม้":{"parts":[{"th":"ดอก","roman":"dɔ̀ɔk","zh":"朵；花朵","id":"prt-ub6a35e71"},{"th":"ไม้","roman":"máai","zh":"树木；木头","id":"u8484676d"}],"why":"ดอก=朵，ไม้=木 →「树木开的朵」＝花。"},"ทั้งหมด":{"parts":[{"th":"ทั้ง","roman":"tháng","zh":"全；整个","id":"prt-u435f1df9"},{"th":"หมด","roman":"mòt","zh":"完；全部","id":"u91945f1f"}],"why":"全+完 →「全都完整（算进来）」＝全部。"},"เมื่อไหร่":{"parts":[{"th":"เมื่อ","roman":"mɯ̂a","zh":"…的时候","id":"prt-uda834660"},{"th":"ไหร่","roman":"rài","zh":"哪；什么（口语）","id":"prt-u4393ac5b"}],"why":"…的时候+哪 →「哪个时候」＝什么时候。"},"เมื่อกี้":{"parts":[{"th":"เมื่อ","roman":"mɯ̂a","zh":"…的时候","id":"prt-uda834660"},{"th":"กี้","roman":"kîi","zh":"刚才（口语）","id":"prt-ud5615976"}],"why":"…的时候+刚才 →「刚才的时候」。"},"ที่สุด":{"parts":[{"th":"ที่","roman":"thîi","zh":"…的","id":"w014"},{"th":"สุด","roman":"sùt","zh":"尽头；极","id":"prt-u57b9bd91"}],"why":"的+尽头 →「到了尽头的」＝最。ที่สุด 放在形容词后：ดีที่สุด 最好。"},"ช่วงนี้":{"parts":[{"th":"ช่วง","roman":"chûang","zh":"一段；期间","id":"u129235ed"},{"th":"นี้","roman":"níi","zh":"这","id":"u3c3cdc8e"}],"why":"一段+这 →「这一段时间」＝最近。"},"ขี้เกียจ":{"parts":[{"th":"ขี้","roman":"khîi","zh":"爱…；容易…（原义：屎）","id":"prt-u09b9355b"},{"th":"เกียจ","roman":"kìat","zh":"懒","id":"prt-u56ab85ff"}],"why":"ขี้=爱…（原义：屎）+เกียจ=懒 →「懒的习性」。ขี้+X＝「爱…的」：ขี้โกหก 爱撒谎的。"},"สิบเอ็ด":{"parts":[{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"},{"th":"เอ็ด","roman":"èt","zh":"一（用在 11、21… 的个位）","id":"prt-u7bb48095"}],"why":"十+一 ＝十一。11、21…个位的「一」用 เอ็ด 不用 หนึ่ง。"},"ยี่สิบ":{"parts":[{"th":"ยี่","roman":"yîi","zh":"二（只用在 20）","id":"prt-udb14c068"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"ยี่=二（只在 20 里用）+十 ＝二十。"},"วันจันทร์":{"parts":[{"th":"วัน","roman":"wan","zh":"天；日","id":"u8c7a2d24"},{"th":"จันทร์","roman":"jan","zh":"月亮","id":"prt-u54b553bd"}],"why":"日+月亮 →「月亮日」＝星期一（和英语 Monday 同一个逻辑）。"},"วันอังคาร":{"parts":[{"th":"วัน","roman":"wan","zh":"天；日","id":"u8c7a2d24"},{"th":"อังคาร","roman":"ang-khaan","zh":"火星","id":"prt-ud62dc04f"}],"why":"日+火星 →「火星日」＝星期二（Tuesday 对应火星）。"},"วันพุธ":{"parts":[{"th":"วัน","roman":"wan","zh":"天；日","id":"u8c7a2d24"},{"th":"พุธ","roman":"phút","zh":"水星","id":"prt-u0ac94359"}],"why":"日+水星 →「水星日」＝星期三。"},"วันพฤหัส":{"parts":[{"th":"วัน","roman":"wan","zh":"天；日","id":"u8c7a2d24"},{"th":"พฤหัส","roman":"phá-rɯ́-hàt","zh":"木星（พฤหัสบดี 的简写）","id":"prt-u1f361367"}],"why":"日+木星 →「木星日」＝星期四（พฤหัสบดี 的简写）。"},"วันศุกร์":{"parts":[{"th":"วัน","roman":"wan","zh":"天；日","id":"u8c7a2d24"},{"th":"ศุกร์","roman":"sùk","zh":"金星","id":"prt-ub82cf3fb"}],"why":"日+金星 →「金星日」＝星期五。"},"วันเสาร์":{"parts":[{"th":"วัน","roman":"wan","zh":"天；日","id":"u8c7a2d24"},{"th":"เสาร์","roman":"sǎo","zh":"土星","id":"prt-u2873b980"}],"why":"日+土星 →「土星日」＝星期六。"},"ผัดไทย":{"parts":[{"th":"ผัด","roman":"phàt","zh":"炒","id":"prt-u351fe83e"},{"th":"ไทย","roman":"thai","zh":"泰国","id":"u892b5b2a"}],"why":"炒+泰国 →「泰式炒（河粉）」。"},"ต้มยำ":{"parts":[{"th":"ต้ม","roman":"tôm","zh":"煮","id":"ud2d2b96e"},{"th":"ยำ","roman":"yam","zh":"酸辣凉拌","id":"prt-uf60c1a22"}],"why":"煮+酸辣凉拌 →「煮出来的酸辣汤」。"},"ส้มตำ":{"parts":[{"th":"ส้ม","roman":"sôm","zh":"酸；橙子","id":"u07d37087"},{"th":"ตำ","roman":"tam","zh":"捣","id":"prt-u6ddf8379"}],"why":"酸+捣 →「酸味的捣菜」＝青木瓜沙拉（用杵捣出来）。"},"ข้าวผัด":{"parts":[{"th":"ข้าว","roman":"khâao","zh":"米饭","id":"w024"},{"th":"ผัด","roman":"phàt","zh":"炒","id":"prt-u351fe83e"}],"why":"饭+炒 ＝炒饭。"},"ข้าวเหนียว":{"parts":[{"th":"ข้าว","roman":"khâao","zh":"米饭","id":"w024"},{"th":"เหนียว","roman":"nǐao","zh":"黏","id":"prt-ue930b269"}],"why":"饭+黏 ＝糯米饭。"},"มะม่วง":{"parts":[{"th":"มะ","roman":"má","zh":"（水果名常见前缀）","id":"prt-u82e52d54"},{"th":"ม่วง","roman":"mûang","zh":"芒果（古）","id":"prt-u2566db62"}],"why":"มะ 是很多水果名的前缀（มะนาว 柠檬、มะพร้าว 椰子…），看到 มะ 开头多半是水果。"},"มะพร้าว":{"parts":[{"th":"มะ","roman":"má","zh":"（水果名常见前缀）","id":"prt-u82e52d54"},{"th":"พร้าว","roman":"pháao","zh":"椰子","id":"prt-uf152c92e"}],"why":"มะ（水果前缀）+椰子 ＝椰子。"},"หรือเปล่า":{"parts":[{"th":"หรือ","roman":"rɯ̌ɯ","zh":"还是","id":"u8abcd03b"},{"th":"เปล่า","roman":"plàao","zh":"空；没有","id":"prt-u62972c91"}],"why":"还是+空/没有 →「是…还是没有？」＝是不是。放句尾做是非问句。"},"ไม่เป็นไร":{"parts":[{"th":"ไม่","roman":"mâi","zh":"不","id":"w005"},{"th":"เป็น","roman":"pen","zh":"是","id":"ud22dc998"},{"th":"ไร","roman":"rai","zh":"什么","id":"prt-ufd0f9990"}],"why":"不+是+什么 →「不是什么（事）」＝没关系。"},"รู้จัก":{"parts":[{"th":"รู้","roman":"rúu","zh":"知道","id":"u796a3268"},{"th":"จัก","roman":"jàk","zh":"认识（古）","id":"prt-ueaa3cb89"}],"why":"知道+认识 →「知道（并认识）」＝认识某人/某地。"},"โชคดี":{"parts":[{"th":"โชค","roman":"chôok","zh":"运气","id":"prt-u6b17d35b"},{"th":"ดี","roman":"dii","zh":"好","id":"uf3dc4902"}],"why":"运气+好 ＝好运。"},"โทรศัพท์":{"parts":[{"th":"โทร","roman":"thoo","zh":"远","id":"u0012e1af"},{"th":"ศัพท์","roman":"sàp","zh":"声音；词","id":"prt-u11bc43df"}],"why":"โทร=远，ศัพท์=声音 →「远方的声音」＝电话（和希腊语 tele-phone 同一个构造）。"},"พัดลม":{"parts":[{"th":"พัด","roman":"phát","zh":"扇；吹","id":"prt-uc0acbc8c"},{"th":"ลม","roman":"lom","zh":"风","id":"udbee1013"}],"why":"扇/吹+风 →「吹风的」＝风扇。"},"ตู้เย็น":{"parts":[{"th":"ตู้","roman":"tûu","zh":"柜子","id":"prt-u0adaa506"},{"th":"เย็น","roman":"yen","zh":"冷","id":"w028"}],"why":"柜子+冷 →「冷的柜子」＝冰箱。"},"ผ้าห่ม":{"parts":[{"th":"ผ้า","roman":"phâa","zh":"布","id":"u47833e2c"},{"th":"ห่ม","roman":"hòm","zh":"盖；披","id":"prt-ua97f23a5"}],"why":"布+盖 →「盖的布」＝被子。"},"แปรงฟัน":{"parts":[{"th":"แปรง","roman":"prɛɛng","zh":"刷子","id":"prt-u94017fff"},{"th":"ฟัน","roman":"fan","zh":"牙","id":"u601fe9bc"}],"why":"刷子+牙 ＝牙刷。"},"ยาสีฟัน":{"parts":[{"th":"ยา","roman":"yaa","zh":"药","id":"uf70c1bb5"},{"th":"สี","roman":"sǐi","zh":"颜色","id":"u002c4998"},{"th":"ฟัน","roman":"fan","zh":"牙","id":"u601fe9bc"}],"why":"药+颜色+牙 →「牙齿的（美白）药」＝牙膏。"},"ปลอดภัย":{"parts":[{"th":"ปลอด","roman":"plɔ̀ɔt","zh":"无；免于","id":"prt-u5df3ae1c"},{"th":"ภัย","roman":"phai","zh":"危险；灾","id":"prt-u1ec21838"}],"why":"无/免于+危险 →「没有危险」＝安全。ปลอด+X＝「无 X」。"},"ข้อความ":{"parts":[{"th":"ข้อ","roman":"khɔ̂ɔ","zh":"条；款","id":"prt-u4cbb446b"},{"th":"ความ","roman":"khwaam","zh":"…性；…的事","id":"u44a99c11"}],"why":"条/款+内容 →「一条内容」＝信息。"},"น้องสาว":{"parts":[{"th":"น้อง","roman":"nɔ́ɔng","zh":"弟妹","id":"u002314bb"},{"th":"สาว","roman":"sǎao","zh":"姑娘；女","id":"prt-u04d2d2ce"}],"why":"弟妹+女 ＝妹妹。น้อง+สาว（女）/ชาย（男）：น้องชาย＝弟弟。"},"จิ้มจุ่ม":{"parts":[{"th":"จิ้ม","roman":"jîm","zh":"蘸","id":"prt-u162e56e3"},{"th":"จุ่ม","roman":"jùm","zh":"浸","id":"prt-u686829aa"}],"why":"蘸+浸 →「蘸着、浸着吃」＝小火锅。"},"หม้อไฟ":{"parts":[{"th":"หม้อ","roman":"môɔ","zh":"锅","id":"prt-uba1f40ff"},{"th":"ไฟ","roman":"fai","zh":"火","id":"ud90f60e4"}],"why":"锅+火 →「点着火的锅」＝火锅。"},"น้ำจิ้ม":{"parts":[{"th":"น้ำ","roman":"náam","zh":"水","id":"w023"},{"th":"จิ้ม","roman":"jîm","zh":"蘸","id":"prt-u162e56e3"}],"why":"水+蘸 →「用来蘸的汁」＝蘸酱。"},"ตรงโน้น":{"parts":[{"th":"ตรง","roman":"trong","zh":"正对；那里","id":"w016"},{"th":"โน้น","roman":"nóon","zh":"那边（更远）","id":"prt-u951b0eda"}],"why":"处+那边（更远）＝更远的那边。นี้ 近、นั้น 中、โน้น 远。"},"พวกเรา":{"parts":[{"th":"พวก","roman":"phûak","zh":"一伙；一群","id":"prt-u519408e9"},{"th":"เรา","roman":"rao","zh":"我们","id":"u9f564c72"}],"why":"พวก=一伙/一群，เรา=我们 →「我们这一伙」，强调「我们大家」。"},"มีความสุข":{"parts":