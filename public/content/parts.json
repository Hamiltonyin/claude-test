{"ไม่มี":{"parts":[{"th":"ไม่","roman":"mâi","zh":"不","id":"w005"},{"th":"มี","roman":"mii","zh":"有","id":"w006"}],"why":"「不」+「有」＝没有。泰语否定直接把 ไม่ 放在动词前，之后所有「不…」都这样造。"},"ตอนนี้":{"parts":[{"th":"ตอน","roman":"tɔɔn","zh":"…的时候","id":"u630ccc5a"},{"th":"นี้","roman":"níi","zh":"这","id":"u3c3cdc8e"}],"why":"ตอน=时段，นี้=这 →「这个时段」＝现在。"},"วันนี้":{"parts":[{"th":"วัน","roman":"wan","zh":"天","id":"u8c7a2d24"},{"th":"นี้","roman":"níi","zh":"这","id":"u3c3cdc8e"}],"why":"วัน=天，นี้=这 →「这一天」＝今天。以后 วันนั้น＝那天，วันนี้ 的结构不变。"},"กลางวัน":{"parts":[{"th":"กลาง","roman":"klaang","zh":"中间","id":"u4c6491f4"},{"th":"วัน","roman":"wan","zh":"天","id":"u8c7a2d24"}],"why":"กลาง=中间，วัน=天 →「一天的中间」＝白天/中午。"},"ห้องน้ำ":{"parts":[{"th":"ห้อง","roman":"hɔ̂ɔng","zh":"房间","id":"uc8102601"},{"th":"น้ำ","roman":"náam","zh":"水","id":"w023"}],"why":"房间+水 →「有水的房间」＝洗手间。"},"เข้าใจ":{"parts":[{"th":"เข้า","roman":"khâo","zh":"进入","id":"uf4cc1c88"},{"th":"ใจ","roman":"jai","zh":"心","id":"ua608f88e"}],"why":"เข้า=进入，ใจ=心 →「进到心里」＝明白、理解。"},"ทำงาน":{"parts":[{"th":"ทำ","roman":"tham","zh":"做","id":"uf5de8abf"},{"th":"งาน","roman":"ngaan","zh":"工作","id":"ub906c43f"}],"why":"做+工作 ＝上班、工作。"},"รถไฟ":{"parts":[{"th":"รถ","roman":"rót","zh":"车","id":"w038"},{"th":"ไฟ","roman":"fai","zh":"火；电","id":"ud90f60e4"}],"why":"车+火（早期靠烧煤）→「火车」，和中文的思路一样。"},"ห้องพัก":{"parts":[{"th":"ห้อง","roman":"hɔ̂ɔng","zh":"房间","id":"uc8102601"},{"th":"พัก","roman":"phák","zh":"休息","id":"ucdacd103"}],"why":"房间+休息 →「休息的房间」＝客房。"},"ร้านอาหาร":{"parts":[{"th":"ร้าน","roman":"ráan","zh":"店","id":"w052"},{"th":"อาหาร","roman":"aa-hǎan","zh":"食物","id":"udd67de2c"}],"why":"店+食物 →「卖食物的店」＝餐馆。"},"น้ำแข็ง":{"parts":[{"th":"น้ำ","roman":"náam","zh":"水","id":"w023"},{"th":"แข็ง","roman":"khɛ̌ng","zh":"硬","id":"ud597f650"}],"why":"水+硬 →「变硬的水」＝冰块。"},"คิดเงิน":{"parts":[{"th":"คิด","roman":"khít","zh":"想","id":"u4b424fa3"},{"th":"เงิน","roman":"ngəən","zh":"钱","id":"w029"}],"why":"算+钱 ＝结账。"},"ใบเสร็จ":{"parts":[{"th":"ใบ","roman":"bai","zh":"张（量词）","id":"u9408dc38"},{"th":"เสร็จ","roman":"sèt","zh":"完成","id":"ufc74b043"}],"why":"ใบ=张（纸）+เสร็จ=完成 →「完成（付款）的那张纸」＝收据。"},"คนไทย":{"parts":[{"th":"คน","roman":"khon","zh":"人","id":"u57a15ffe"},{"th":"ไทย","roman":"thai","zh":"泰国","id":"u892b5b2a"}],"why":"人+泰国 ＝泰国人。国名/语言都能这么接：คนจีน 中国人。"},"ภาษาไทย":{"parts":[{"th":"ภาษา","roman":"phaa-sǎa","zh":"语言","id":"u081ff798"},{"th":"ไทย","roman":"thai","zh":"泰国","id":"u892b5b2a"}],"why":"ภาษา=语言+ไทย →「泰国的语言」。换国名就是别国语言：ภาษาจีน。"},"ภาษาจีน":{"parts":[{"th":"ภาษา","roman":"phaa-sǎa","zh":"语言","id":"u081ff798"},{"th":"จีน","roman":"jiin","zh":"中国","id":"u6a7a8bad"}],"why":"语言+中国 ＝中文。"},"คิดถึง":{"parts":[{"th":"คิด","roman":"khít","zh":"想","id":"u4b424fa3"},{"th":"ถึง","roman":"thɯ̌ng","zh":"到","id":"w044"}],"why":"想+到 →「想到（某人）」＝想念。"},"แม่น้ำ":{"parts":[{"th":"แม่","roman":"mɛ̂ɛ","zh":"妈妈","id":"u787d108d"},{"th":"น้ำ","roman":"náam","zh":"水","id":"w023"}],"why":"妈妈+水 →「水的母亲」＝大河；河像孕育一切的母亲。"},"ที่นี่":{"parts":[{"th":"ที่","roman":"thîi","zh":"地方","id":"w014"},{"th":"นี่","roman":"nîi","zh":"这","id":"u3d3cde21"}],"why":"ที่=地方，นี่=这 →「这个地方」＝这里；ที่นั่น＝那里，一套结构。"},"ที่นั่น":{"parts":[{"th":"ที่","roman":"thîi","zh":"地方","id":"w014"},{"th":"นั่น","roman":"nân","zh":"那","id":"u4aadcfe4"}],"why":"地方+那 ＝那里。"},"บางครั้ง":{"parts":[{"th":"บาง","roman":"baang","zh":"有些","id":"u0faec31e"},{"th":"ครั้ง","roman":"khráng","zh":"次","id":"u989b272b"}],"why":"บาง=有些，ครั้ง=次 →「有些次」＝有时候。"},"ไม่เคย":{"parts":[{"th":"ไม่","roman":"mâi","zh":"不","id":"w005"},{"th":"เคย","roman":"khəəi","zh":"曾经","id":"u09119ad9"}],"why":"不+曾经 ＝从没有过。"},"เดี๋ยวนี้":{"parts":[{"th":"เดี๋ยว","roman":"dǐao","zh":"一会儿；马上","id":"w035"},{"th":"นี้","roman":"níi","zh":"这","id":"u3c3cdc8e"}],"why":"一会儿/马上+这 →「就在这一刻」＝现在、马上。"},"น่ารัก":{"parts":[{"th":"น่า","roman":"nâa","zh":"值得","id":"uc8b752d2"},{"th":"รัก","roman":"rák","zh":"爱","id":"u014955c8"}],"why":"น่า=值得，รัก=爱 →「值得爱」＝可爱。น่า+动词＝「值得/令人…」，如 น่ากลัว（令人害怕）。"},"ดีใจ":{"parts":[{"th":"ดี","roman":"dii","zh":"好","id":"uf3dc4902"},{"th":"ใจ","roman":"jai","zh":"心","id":"ua608f88e"}],"why":"好+心 ＝高兴。泰语很多情绪词都是「某某+ใจ」：心好、心坏、心掉…"},"เสียใจ":{"parts":[{"th":"เสีย","roman":"sǐa","zh":"坏；失去","id":"u545c8924"},{"th":"ใจ","roman":"jai","zh":"心","id":"ua608f88e"}],"why":"坏/失去+心 ＝难过、遗憾。"},"ตกใจ":{"parts":[{"th":"ตก","roman":"tòk","zh":"落；掉","id":"u9bdfcbe3"},{"th":"ใจ","roman":"jai","zh":"心","id":"ua608f88e"}],"why":"落/掉+心 →「心掉下去」＝吓一跳。"},"สบายใจ":{"parts":[{"th":"สบาย","roman":"sà-baai","zh":"舒服","id":"uad647075"},{"th":"ใจ","roman":"jai","zh":"心","id":"ua608f88e"}],"why":"舒服+心 ＝心情舒畅、放心。"},"สามสิบ":{"parts":[{"th":"สาม","roman":"sǎam","zh":"三","id":"u06d2d5f4"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"三+十 ＝三十。整十：个位数+สิบ（二十例外，用 ยี่）。"},"สี่สิบ":{"parts":[{"th":"สี่","roman":"sìi","zh":"四","id":"u15b50c70"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"四+十 ＝四十。"},"ห้าสิบ":{"parts":[{"th":"ห้า","roman":"hâa","zh":"五","id":"uc07b3a71"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"五+十 ＝五十。"},"หกสิบ":{"parts":[{"th":"หก","roman":"hòk","zh":"六","id":"u0ffe1031"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"六+十 ＝六十。"},"เจ็ดสิบ":{"parts":[{"th":"เจ็ด","roman":"jèt","zh":"七","id":"u2ee19d86"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"七+十 ＝七十。"},"แปดสิบ":{"parts":[{"th":"แปด","roman":"pɛ̀ɛt","zh":"八","id":"ud84c46b3"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"八+十 ＝八十。"},"เก้าสิบ":{"parts":[{"th":"เก้า","roman":"kâao","zh":"九","id":"u6383f121"},{"th":"สิบ","roman":"sìp","zh":"十","id":"u09b0ec23"}],"why":"九+十 ＝九十。"},"สองร้อย":{"parts":[{"th":"สอง","roman":"sɔ̌ɔng","zh":"二","id":"u14cede95"},{"th":"ร้อย","roman":"rɔ́ɔi","zh":"百","id":"u630ccfd2"}],"why":"二+百 ＝两百。数字顺序和中文一样：几 + 单位。"},"ห้าร้อย":{"parts":[{"th":"ห้า","roman":"hâa","zh":"五","id":"uc07b3a71"},{"th":"ร้อย","roman":"rɔ́ɔi","zh":"百","id":"u630ccfd2"}],"why":"五+百 ＝五百。"},"วันอาทิตย์":{"parts":[{"th":"วัน","roman":"wan","zh":"天","id":"u8c7a2d24"},{"th":"อาทิตย์","roman":